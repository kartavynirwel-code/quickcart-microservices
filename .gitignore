# ==============================
# Root-level secrets
# ==============================
.env
!.env.example

# ==============================
# frontend/ (Node / React)
# ==============================
frontend/node_modules/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# ==============================
# product-order-service/ (Java / Maven)
# ==============================
product-order-service/target/
product-order-service/.env
product-order-service/*.log
product-order-service/.mvn/wrapper/maven-wrapper.jar

# ==============================
# payment-service/ (Python / FastAPI)
# ==============================
payment-service/__pycache__/
payment-service/*.pyc
payment-service/.venv/
payment-service/venv/
payment-service/env/
payment-service/.env
payment-service/*.egg-info/
payment-service/.pytest_cache/

# ==============================
# Docker
# ==============================
*.env.local
docker-compose.override.yml

# ==============================
# Kubernetes
# ==============================
# Secret manifest has real passwords in stringData - don't commit as-is.
# Keep a secret.example.yaml with placeholder values instead.
k8s/manifests/secrets.yaml
!k8s/manifests/secret.example.yaml

# Any local kubeconfig accidentally copied into repo
kubeconfig
*.kubeconfig
.kube/

# kind cluster config, if it ever contains local-only paths/ports
kind-config.local.yaml

# ==============================
# Editors / IDEs
# ==============================
.idea/
.vscode/
*.iml
*.swp
*.swo

# ==============================
# OS junk
# ==============================
.DS_Store
Thumbs.db